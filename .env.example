# ============================================================================
# RESTAURANT MANAGEMENT SYSTEM (RMS) - GLOBAL ENVIRONMENT CONFIGURATION
# Location: restaurant-management-system/.env.example
# All microservices read from this single root environment file.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & CORS
# ----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=RestaurantManagementSystem
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ----------------------------------------------------------------------------
# 2. MICROSOFT SQL SERVER CONFIGURATION (SINGLE SHARED DATABASE)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_NAME=RestaurantManagementDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_DIALECT=mssql
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ----------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (CACHING, RATE LIMITING & STATE)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT & SERVICE-TO-SERVICE)
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=rms_super_secret_jwt_access_key_min_32_characters_long_12345
JWT_REFRESH_SECRET=rms_super_secret_jwt_refresh_key_min_32_characters_long_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_KEY=rms_internal_microservice_mesh_secret_token_54321

# ----------------------------------------------------------------------------
# 5. SERVICE PORTS (MICROSERVICE RUNTIME PORTS)
# ----------------------------------------------------------------------------
PORT_API_GATEWAY=8000
PORT_AUTH_SERVICE=8001
PORT_USER_SERVICE=8002
PORT_RESTAURANT_SERVICE=8003
PORT_CMS_SERVICE=8004
PORT_MENU_SERVICE=8005
PORT_CART_SERVICE=8006
PORT_ORDER_SERVICE=8007
PORT_PAYMENT_SERVICE=8008
PORT_INVENTORY_SERVICE=8009
PORT_KITCHEN_SERVICE=8010
PORT_RESERVATION_SERVICE=8011
PORT_NOTIFICATION_SERVICE=8012
PORT_REPORT_SERVICE=8013

# ----------------------------------------------------------------------------
# 6. INTERNAL MICROSERVICE URLS (FOR INTER-SERVICE REST CALLS)
# For local run: use http://localhost:<port>
# For docker run: use http://<container-name>:<port>
# ----------------------------------------------------------------------------
URL_AUTH_SERVICE=http://localhost:8001
URL_USER_SERVICE=http://localhost:8002
URL_RESTAURANT_SERVICE=http://localhost:8003
URL_CMS_SERVICE=http://localhost:8004
URL_MENU_SERVICE=http://localhost:8005
URL_CART_SERVICE=http://localhost:8006
URL_ORDER_SERVICE=http://localhost:8007
URL_PAYMENT_SERVICE=http://localhost:8008
URL_INVENTORY_SERVICE=http://localhost:8009
URL_KITCHEN_SERVICE=http://localhost:8010
URL_RESERVATION_SERVICE=http://localhost:8011
URL_NOTIFICATION_SERVICE=http://localhost:8012
URL_REPORT_SERVICE=http://localhost:8013

# ----------------------------------------------------------------------------
# 7. CLOUDINARY CONFIGURATION (CMS & MENU MEDIA ASSETS)
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------------------------------------------------------------------
# 8. RAZORPAY GATEWAY CONFIGURATION (PAYMENTS & WEBHOOKS)
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ----------------------------------------------------------------------------
# 9. EMAIL & SMTP CONFIGURATION (NOTIFICATIONS & PASSWORDS)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@antigravitybistro.com

